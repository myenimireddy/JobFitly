{
  "manifest_version": 3,
  "name": "JobFitly",
  "version": "1.1.0",
  "description": "Fill job applications from your resume — side panel stays open while you review each field",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JobFitly"
  },
  "side_panel": {
    "default_path": "src/sidepanel/main.html"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
