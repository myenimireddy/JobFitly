{
  "name": "jobfitcheck-extension",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/panel-edges.js && node tests/mock-runner.js && node tests/kitchen-sink-runner.js",
    "test:offline": "playwright test --project=offline",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "npm run build && playwright test --project=e2e-ui",
    "test:e2e:ui:live": "npm run build && LIVE_ATS=1 playwright test --project=e2e-ui",
    "test:e2e:live": "LIVE_ATS=1 playwright test --project=e2e",
    "test:e2e:customer": "LIVE_ATS=1 playwright test --project=e2e e2e/live-test-customer-1.spec.js",
    "test:all": "npm test && npm run test:offline && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@playwright/test": "^1.49.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8"
  }
}
