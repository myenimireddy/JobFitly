{
  "name": "jobfitcheck-backend",
  "version": "0.1.0",
  "description": "Job matching API with resume parsing and gap analysis",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:feature:profile": "jest --runInBand src/modules/profile/service.test.js src/modules/profile/applicationFields.test.js",
    "test:feature:configuration": "jest --runInBand src/lib/llmSettings.test.js src/lib/groqModels.test.js",
    "test:feature:analysis": "jest --runInBand src/modules/job/service.test.js src/lib/resumeSections.test.js",
    "test:feature:hitl": "jest --runInBand src/modules/autofill/logic.test.js src/modules/autofill/service.test.js",
    "test:features": "npm run test:feature:profile && npm run test:feature:configuration && npm run test:feature:analysis && npm run test:feature:hitl",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "seed:test-customer-1": "node scripts/seed-test-customer-1.js",
    "seed:role-profiles": "node scripts/seed-role-profiles.js"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "groq-sdk": "^0.3.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.6.0"
  }
}
