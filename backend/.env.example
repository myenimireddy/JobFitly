# Database
# SQLite (default for development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL production (requires different prisma schema):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobfitly?schema=public"

# Server
PORT=3000
NODE_ENV=development

# AI Services
# LLM Provider: 'ollama' (local) or 'groq' (hosted)
LLM_PROVIDER=ollama

# Ollama (local) configuration
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Groq (hosted) configuration
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama3-70b-8192

# CORS
CORS_ORIGIN=http://localhost:5173
