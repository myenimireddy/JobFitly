# Database
# SQLite (default for development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL production (requires different prisma schema):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobfitly?schema=public"

# Server
PORT=3000
NODE_ENV=development

# AI Services
# Effective provider is resolved at runtime (see src/lib/llmSettings.js):
#   Settings "Use Ollama" → Ollama
#   else usable Groq key (UI file or GROQ_API_KEY) → Groq
#   else → Ollama
# LLM_PROVIDER is legacy; prefer Settings gear or GROQ_API_KEY below.
LLM_PROVIDER=ollama

# Ollama (local) — fallback when no Groq key / forceOllama
# 7b is accurate but slow on CPU. Prefer 3b for local fill testing:
#   ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Groq (hosted, optional) — free key: https://console.groq.com/keys
# Can also be set from the extension Settings UI (stored in data/llm-settings.json).
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama3-70b-8192

# CORS
CORS_ORIGIN=http://localhost:5173
